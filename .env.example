GEMINI_API_KEY=coloque_sua_chave_aqui
# Vazio: usa memoria_jarvis_v2 ao lado de main.py.
# Depois de copiar o banco para o pen drive, configure o caminho real:
# JANUS_DB_PATH=E:/Janus/memoria_jarvis_v2
JANUS_DB_PATH=

# Economia: limites em caracteres, exceto os campos explicitamente em tokens.
JANUS_HISTORICO_PARES=6
JANUS_HISTORICO_CHARS=12000
JANUS_RESUMO_CHARS=2000
JANUS_FERRAMENTA_CHARS=4000
JANUS_MEMORIA_CHARS=1600
# Distância máxima x 1000, na métrica da coleção existente; ajuste após observar relevância.
JANUS_MEMORIA_DISTANCIA_MIL=800
JANUS_MAX_OUTPUT_TOKENS=2048
JANUS_MAX_CHAMADAS=8
MAX_FILE_READ_CHARS=3000
MAX_WEB_SCRAPE_CHARS_PER_PAGE=1000
