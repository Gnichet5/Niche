/* Janus · Premium Minimalist UI — SKILLS/design.md */

/* 1. Tema claro padrão e tokens compartilhados */
:root {
  color-scheme: light;
  --bg-main: #f9f8f6;
  --bg-panel: rgba(255, 255, 255, 0.25);
  --text-main: #1a1a1a;
  --accent: #c5a880;
  --text-secondary: #62615e;
  --accent-text: #76603f;
  --bg-solid: #fffefa;
  --bg-inset: #f0ede7;
  --border: rgba(102, 89, 64, 0.17);
  --glass-border: rgba(255, 255, 255, 0.18);
  --glass-shadow: inset 0 1px 2px rgba(255, 255, 255, 0.2), 0 20px 50px rgba(0, 0, 0, 0.02);
  --hover-shadow: 0 20px 40px rgba(0, 0, 0, 0.03);
  --hover-glow: inset 0 1px 6px rgba(255, 255, 255, 0.4), 0 20px 40px rgba(0, 0, 0, 0.03);
  --highlight: rgba(255, 255, 255, 0.76);
  --hover-panel: rgba(255, 255, 255, 0.86);
  --selected: rgba(197, 168, 128, 0.17);
  --ambient-gold: rgba(197, 168, 128, 0.24);
  --ambient-cool: rgba(149, 167, 172, 0.15);
  --blob-1: rgba(0, 0, 0, 0.07);
  --blob-2: rgba(189, 166, 130, 0.15);
  --error: #a3322c;
  --button-ink: #211b13;
  --motion: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
  --motion-water: all 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  --radius-panel: 28px;
  --sidebar-space: 238px;
}

body.dark-mode {
  color-scheme: dark;
  --bg-main: #121212;
  --bg-panel: rgba(20, 22, 22, 0.25);
  --text-main: #e5e5e5;
  --accent: #d4af37;
  --text-secondary: #b6b3ad;
  --accent-text: #d4af37;
  --bg-solid: #222220;
  --bg-inset: #282723;
  --border: rgba(224, 213, 187, 0.18);
  --glass-border: rgba(255, 255, 255, 0.1);
  --glass-shadow: inset 0 1px 2px rgba(255, 255, 255, 0.05), 0 20px 50px rgba(0, 0, 0, 0.2);
  --hover-glow: inset 0 1px 6px rgba(255, 255, 255, 0.08), 0 20px 40px rgba(0, 0, 0, 0.22);
  --highlight: rgba(255, 245, 221, 0.08);
  --hover-panel: rgba(45, 43, 38, 0.88);
  --hover-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
  --selected: rgba(212, 175, 55, 0.11);
  --ambient-gold: rgba(140, 108, 39, 0.15);
  --ambient-cool: rgba(78, 94, 111, 0.17);
  --blob-1: rgba(255, 255, 255, 0.05);
  --blob-2: rgba(212, 175, 55, 0.08);
  --error: #ffaca0;
}

/* 2. Base acessível */
* { box-sizing: border-box; }
body {
  margin: 0;
  background: var(--bg-main);
  color: var(--text-main);
  font: 14px/1.6 'Segoe UI', system-ui, sans-serif;
  transition: background-color 0.3s ease, color 0.3s ease;
  isolation: isolate;
}
body::before {
  content: '';
  position: fixed;
  inset: 0;
  z-index: -1;
  pointer-events: none;
  background: radial-gradient(ellipse at 80% 4%, var(--ambient-gold), transparent 55%),
              radial-gradient(ellipse at 22% 50%, var(--ambient-cool), transparent 58%);
  transition: var(--motion);
}

/* 1b. Cenário ambiente — esferas borradas e partículas (SKILLS/design.md §2) */
.ambient-background {
  position: fixed;
  inset: 0;
  z-index: -1;
  overflow: hidden;
  pointer-events: none;
}
.ambient-background .blob {
  position: fixed;
  border-radius: 50%;
  filter: blur(80px);
  will-change: transform;
}
.ambient-background .blob-1 {
  top: -12%;
  right: -8%;
  width: 46vw;
  height: 46vw;
  background: var(--blob-2);
  animation: float 26s ease-in-out infinite;
}
.ambient-background .blob-2 {
  bottom: -16%;
  left: -10%;
  width: 40vw;
  height: 40vw;
  background: var(--blob-1);
  animation: float 32s ease-in-out infinite reverse;
}
.ambient-background .particle {
  position: fixed;
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background: var(--accent);
  box-shadow: 0 0 4px 0 var(--accent);
  opacity: 0.25;
  animation: ember-glow 5s ease-in-out infinite;
}
.ambient-background .particle:nth-child(3) { top: 18%; left: 12%; animation-delay: -0.5s; }
.ambient-background .particle:nth-child(4) { top: 64%; left: 22%; animation-delay: -1.8s; }
.ambient-background .particle:nth-child(5) { top: 30%; left: 68%; animation-delay: -3.2s; }
.ambient-background .particle:nth-child(6) { top: 78%; left: 58%; animation-delay: -2.1s; }
.ambient-background .particle:nth-child(7) { top: 46%; left: 85%; animation-delay: -4s; }
.ambient-background .particle:nth-child(8) { top: 8%; left: 44%; animation-delay: -0.9s; }
@keyframes ember-glow {
  0%, 100% { opacity: 0.15; box-shadow: 0 0 3px 0 var(--accent); }
  50% { opacity: 0.65; box-shadow: 0 0 9px 2px var(--accent); }
}
@keyframes float {
  0%, 100% { transform: translate(0, 0) scale(1); }
  50% { transform: translate(2%, 3%) scale(1.05); }
}
button, textarea { font: inherit; color: inherit; }
button {
  cursor: pointer;
  padding: 9px 14px;
  border: 1px solid var(--border);
  border-radius: 10px;
  background: var(--bg-solid);
}
button, a, .suggestion-card { transition: var(--motion); }
button:disabled { opacity: 0.5; cursor: wait; transform: none; }
button:not(:disabled):hover { background: var(--hover-panel); }
button:not(:disabled):active, a:active { transform: scale(0.98); }
button:focus-visible, a:focus-visible, summary:focus-visible {
  outline: 2px solid var(--accent-text);
  outline-offset: 4px;
}
textarea:focus-visible { outline: none; }
[hidden] { display: none !important; }
.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}
.eyebrow { font-size: 10px; letter-spacing: 1.6px; font-weight: 600; color: var(--text-secondary); }
.muted { color: var(--text-secondary); font-size: 12px; }
.quiet { background: transparent; border: 0; color: var(--text-secondary); padding: 7px 9px; font-size: 12px; }
.quiet:not(:disabled):hover, .quiet[aria-pressed=true] { background: var(--selected); color: var(--text-main); }
.button-row { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
.primary, .send { background: var(--accent); color: var(--button-ink); border-color: var(--accent); }
.primary:not(:disabled):hover, .send:not(:disabled):hover { background: var(--text-main); color: var(--bg-main); }

/* 3. Superfície de vidro compartilhada, incluindo painéis dinâmicos */
.glass-panel, .memory-record, .attachment, dialog {
  background: var(--bg-panel);
  border: 1px solid var(--glass-border);
  -webkit-backdrop-filter: blur(32px) saturate(130%);
  backdrop-filter: blur(32px) saturate(130%);
  box-shadow: var(--glass-shadow);
  border-radius: var(--radius-panel);
  transition: var(--motion-water);
}
/* Bolha do usuário carrega texto crítico por cima dos blobs — fica mais opaca
   que os painéis estruturais para garantir contraste de leitura. */
.message.user {
  background: var(--hover-panel);
  border: 1px solid var(--glass-border);
  -webkit-backdrop-filter: blur(14px) saturate(120%);
  backdrop-filter: blur(14px) saturate(120%);
  box-shadow: var(--glass-shadow);
  transition: var(--motion-water);
}

/* 3b. Hover "toque na água" — cards e botões (SKILLS/design.md §4) */
.glass-panel:not(button), .suggestion-card, .new-chat, button.primary, button.send {
  transition: var(--motion-water);
}
@media (hover: hover) and (pointer: fine) {
  .glass-panel:not(button):hover, .suggestion-card:not(:disabled):hover,
  .new-chat:not(:disabled):hover {
    transform: scale(1.015);
    box-shadow: var(--hover-glow);
  }
}
.glass-panel:active, .suggestion-card:not(:disabled):active, .new-chat:not(:disabled):active,
button:not(:disabled):active, a:active {
  transform: scale(0.985);
  transition: all 0.1s;
}

/* 4. Navegação */
.sidebar {
  position: fixed;
  inset: 16px auto 16px 16px;
  width: 222px;
  padding: 27px 18px;
  display: flex;
  flex-direction: column;
  border-radius: 22px;
  z-index: 10;
}
.brand { font-size: 34px; letter-spacing: -1.8px; font-weight: 500; color: var(--text-main); text-decoration: none; padding: 0 8px; width: fit-content; }
.brand span { color: var(--accent-text); }
.brand:hover { color: var(--accent-text); }
.brand-caption { font-size: 11px; color: var(--text-secondary); margin: 0 8px 28px; }
.new-chat { text-align: left; margin-bottom: 25px; padding: 12px 15px; border-radius: 12px; }
.sidebar nav { display: grid; gap: 5px; }
.nav-item { display: flex; justify-content: space-between; text-align: left; padding: 11px 14px; color: var(--text-secondary); background: transparent; border: 1px solid transparent; }
.nav-item.active { color: var(--text-main); background: var(--selected); border-color: var(--border); }
.sidebar-note { margin: 35px 13px; color: var(--text-secondary); font-size: 12px; overflow-wrap: anywhere; }
.sidebar footer { margin-top: auto; }
.identity { display: flex; gap: 11px; align-items: center; font-size: 12px; }
.identity small { display: block; color: var(--text-secondary); font-size: 10px; }
.avatar { width: 34px; height: 34px; display: grid; place-items: center; background: var(--selected); border: 1px solid var(--border); border-radius: 50%; }
.sidebar footer button { margin: 18px 0 0; }
main { margin-left: var(--sidebar-space); min-height: 100vh; }
.topbar { position: sticky; top: 16px; height: 62px; margin: 16px 26px 0; padding: 0 24px; display: flex; align-items: center; justify-content: space-between; gap: 12px; border-radius: 17px; font-size: 12px; color: var(--text-secondary); z-index: 9; }
.connection { display: flex; align-items: center; gap: 8px; }
.status-dot { display: inline-block; width: 6px; height: 6px; flex-shrink: 0; border-radius: 50%; background: var(--text-secondary); box-shadow: 0 0 3px 0 currentColor; color: var(--text-secondary); }

/* 5. Tela inicial e cards inferiores */
.chat-view { max-width: 900px; min-height: calc(100vh - 94px); margin: auto; padding: 0 42px 24px; display: flex; flex-direction: column; }
.welcome { position: relative; isolation: isolate; text-align: center; padding: 65px 0 40px; margin: auto 0; }
.welcome::before {
  content: '';
  position: absolute;
  top: 6px;
  left: 50%;
  translate: -50% 0;
  width: 240px;
  height: 240px;
  background: radial-gradient(circle, var(--ambient-gold), transparent 70%);
  filter: blur(50px);
  z-index: -1;
  pointer-events: none;
}
.monogram { width: 64px; height: 64px; border-radius: 21px; font: 36px Georgia, serif; display: grid; place-items: center; margin: 0 auto 27px; color: var(--accent-text); transition: var(--motion-water); }
@media (hover: hover) and (pointer: fine) {
  .monogram:hover { transform: scale(1.06) rotate(-3deg); box-shadow: var(--hover-glow); }
}
.welcome h1, .memory-view h1 { font: 400 43px/1.15 Georgia, serif; letter-spacing: -1.25px; margin: 19px 0; }
.welcome p { color: var(--text-secondary); font-size: 14px; line-height: 1.8; margin: 0; }
.suggestions { display: grid; grid-template-columns: 1.15fr 1fr; gap: 14px; margin: 36px auto 0; max-width: 630px; }
.suggestion-card { position: relative; text-align: left; padding: 18px 21px; border-radius: 17px; }
.suggestion-card.featured { padding: 22px 24px; }
.suggestion-card.featured .suggestion-symbol { font-size: 24px; }
.suggestion-card.featured strong { font-size: 13px; }
.suggestion-card::before { content: ''; position: absolute; inset: 0; pointer-events: none; border-radius: inherit; background: linear-gradient(135deg, var(--highlight), transparent 60%); opacity: 0; transition: var(--motion); }
.suggestion-card strong { display: block; font-size: 12px; font-weight: 500; margin: 9px 0 3px; }
.suggestion-card small { font-size: 11px; color: var(--text-secondary); }
.suggestion-symbol { font-size: 20px; color: var(--text-main); }
.arrow { position: absolute; right: 18px; top: 20px; color: var(--text-secondary); transition: var(--motion); }
.suggestion-card > span, .suggestion-card > strong, .suggestion-card > small { isolation: isolate; }
@media (hover: hover) and (pointer: fine) {
  .suggestion-card:not(:disabled):hover { border-color: var(--border); }
  .suggestion-card:not(:disabled):hover::before { opacity: 1; }
  .suggestion-card:not(:disabled):hover .arrow { transform: translate(2px, -2px); color: var(--accent-text); }
}

/* 6. Conversa e campo de mensagem */
.composer-area { margin-top: auto; padding-top: 22px; }
.composer { border-radius: 22px; padding: 19px 19px 13px; }
.composer:focus-within { border-color: var(--text-secondary); box-shadow: var(--hover-glow); transition: var(--motion-water); }
textarea { display: block; resize: vertical; min-height: 60px; max-height: 240px; width: 100%; border: 0; background: transparent; font-size: 14px; padding: 0 4px; }
textarea::placeholder { color: var(--text-secondary); }
.composer-bottom { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
.composer-tools { display: flex; gap: 4px; flex-wrap: wrap; }
.send { width: 39px; height: 39px; padding: 0; font-size: 23px; border-radius: 13px; }
.composer-foot { display: flex; justify-content: space-between; gap: 12px; font-size: 10px; color: var(--text-secondary); margin: 12px 3px 0; }
.messages { padding-top: 28px; }
.message { margin: 20px 0 34px; overflow-wrap: anywhere; }
.message.user { max-width: 85%; width: fit-content; margin-left: auto; padding: 13px 20px; border-radius: 18px 18px 4px 18px; white-space: pre-wrap; }
.message.assistant .message-label { font-size: 11px; font-weight: 600; color: var(--text-secondary); letter-spacing: 1px; margin-bottom: 10px; }
.message-content { font-size: 15px; line-height: 1.9; white-space: pre-wrap; }
.message-content pre { white-space: pre; overflow: auto; max-width: 100%; font-size: 12px; background: var(--bg-inset); border: 1px solid var(--border); padding: 16px; border-radius: 10px; }
.message details { font-size: 11px; color: var(--text-secondary); margin-top: 15px; }
.message summary { cursor: pointer; width: fit-content; transition: var(--motion); }
.message details pre { white-space: pre-wrap; overflow-wrap: anywhere; font-size: 11px; }
.progress { display: flex; align-items: center; gap: 10px; font-size: 12px; color: var(--text-secondary); margin: 12px 0; }
.dot-spinner { position: relative; width: 16px; height: 16px; flex-shrink: 0; }
.dot-spinner span { position: absolute; inset: 0; display: flex; align-items: flex-start; justify-content: center; }
.dot-spinner span::before {
  content: '';
  width: 2.5px;
  height: 2.5px;
  border-radius: 50%;
  background: var(--accent);
  box-shadow: 0 0 4px 0.5px var(--accent);
  opacity: 0.15;
  animation: dot-spinner-fade 1s linear infinite;
}
.dot-spinner span:nth-child(1) { transform: rotate(0deg); }
.dot-spinner span:nth-child(2) { transform: rotate(45deg); }
.dot-spinner span:nth-child(3) { transform: rotate(90deg); }
.dot-spinner span:nth-child(4) { transform: rotate(135deg); }
.dot-spinner span:nth-child(5) { transform: rotate(180deg); }
.dot-spinner span:nth-child(6) { transform: rotate(225deg); }
.dot-spinner span:nth-child(7) { transform: rotate(270deg); }
.dot-spinner span:nth-child(8) { transform: rotate(315deg); }
.dot-spinner span:nth-child(1)::before { animation-delay: -0.875s; }
.dot-spinner span:nth-child(2)::before { animation-delay: -0.75s; }
.dot-spinner span:nth-child(3)::before { animation-delay: -0.625s; }
.dot-spinner span:nth-child(4)::before { animation-delay: -0.5s; }
.dot-spinner span:nth-child(5)::before { animation-delay: -0.375s; }
.dot-spinner span:nth-child(6)::before { animation-delay: -0.25s; }
.dot-spinner span:nth-child(7)::before { animation-delay: -0.125s; }
.dot-spinner span:nth-child(8)::before { animation-delay: 0s; }
@keyframes dot-spinner-fade {
  0%, 100% { opacity: 0.15; }
  50% { opacity: 1; }
}
.approval { padding: 22px; border-radius: 15px; margin: 15px 0; }
.approval h2 { font: 400 20px Georgia, serif; letter-spacing: -0.3px; }
.approval pre { white-space: pre-wrap; overflow-wrap: anywhere; background: var(--bg-inset); padding: 14px; border-radius: 8px; font-size: 12px; }
.attachment { display: flex; align-items: center; gap: 12px; font-size: 12px; margin-bottom: 10px; overflow-wrap: anywhere; padding: 10px 13px; border-radius: 14px; }
.attachment img { height: 52px; width: 65px; object-fit: cover; border-radius: 8px; }
.attachment span { flex: 1; }

/* 7. Memória e confirmações */
.memory-view { max-width: 890px; margin: auto; padding: 60px 42px; }
.memory-record { margin-top: 18px; padding: 20px; border-radius: 16px; }
.memory-record p { white-space: pre-wrap; overflow-wrap: anywhere; font-size: 13px; }
.memory-record button { font-size: 12px; }
#memory-list:empty::before {
  content: 'Nenhuma memória ainda. O que você conversar aqui pode ficar guardado — e você decide o que continua.';
  display: block;
  margin-top: 18px;
  padding: 40px 24px;
  text-align: center;
  color: var(--text-secondary);
  font-size: 13px;
  border: 1px dashed var(--border);
  border-radius: var(--radius-panel);
}
.notice { position: fixed; bottom: 18px; right: 22px; max-width: min(520px, 90vw); padding: 15px 20px; background: var(--bg-solid); color: var(--error); border: 1px solid var(--error); border-radius: 12px; box-shadow: var(--glass-shadow); z-index: 20; }
dialog { color: var(--text-main); max-width: min(480px, 90vw); border-radius: 22px; padding: 28px; }
dialog::backdrop { background: rgba(10, 13, 18, 0.45); -webkit-backdrop-filter: blur(5px); backdrop-filter: blur(5px); }
dialog h2 { font: 400 24px Georgia, serif; letter-spacing: -0.4px; }
dialog p { font-size: 13px; color: var(--text-secondary); }

/* 8. Micro-interações e movimento reduzido */
@keyframes fadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
.main-panel { animation: fadeIn 0.5s cubic-bezier(0.25, 0.8, 0.25, 1) both; }
.message, .approval, .memory-record { animation: fadeIn 0.3s ease both; }
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation: none !important; transition: none !important; }
  .suggestion-card:not(:disabled):hover, .suggestion-card:not(:disabled):active,
  .glass-panel:hover, .glass-panel:active, .new-chat:not(:disabled):hover,
  button:not(:disabled):active, a:active { transform: none; }
  .ambient-background .blob { animation: none; }
  .dot-spinner span::before { opacity: 0.6 !important; }
}

/* 9. Responsivo */
@media (max-width: 900px) {
  :root { --sidebar-space: 190px; }
  .sidebar { inset: 12px auto 12px 12px; width: 178px; padding: 24px 12px; }
  .topbar { margin: 12px 18px 0; top: 12px; padding: 0 18px; }
  .chat-view { min-height: calc(100vh - 86px); padding: 0 24px 20px; }
  .welcome h1 { font-size: 36px; }
  .suggestions { gap: 10px; }
  .suggestion-card { padding: 15px; }
}
@media (max-width: 640px) {
  :root { --sidebar-space: 0px; }
  .sidebar { position: relative; inset: auto; width: auto; margin: 12px 12px 0; padding: 13px 15px; border-radius: 18px; flex-direction: row; align-items: center; gap: 12px; flex-wrap: wrap; }
  .brand { font-size: 27px; padding: 0; }
  .brand-caption, .sidebar-note, .identity { display: none; }
  .new-chat { margin: 0 0 0 auto; padding: 7px 12px; font-size: 12px; }
  .sidebar nav { display: flex; width: 100%; gap: 8px; }
  .nav-item { flex: 1; font-size: 12px; }
  .nav-item span { display: none; }
  .sidebar footer { margin: 0; width: 100%; }
  .sidebar footer button { margin: 0; padding: 4px 8px; }
  .topbar { height: 46px; margin: 10px 12px 0; top: 10px; border-radius: 13px; }
  .chat-view { min-height: calc(100dvh - 225px); padding: 0 18px 18px; }
  .welcome { padding: 36px 0 20px; }
  .welcome h1 { font-size: 34px; }
  .welcome p { font-size: 13px; }
  .monogram { width: 56px; height: 56px; border-radius: 18px; }
  .suggestions { margin-top: 25px; }
  .suggestion-card { border-radius: 14px; }
  .suggestion-card small { display: none; }
  .suggestion-card strong { font-size: 11px; }
  .composer-foot span:last-child { display: none; }
  .memory-view { padding: 32px 22px; }
  .memory-view h1 { font-size: 33px; }
  .composer { border-radius: 18px; padding: 14px; }
  textarea { font-size: 16px; }
  .quiet { padding: 8px 5px; }
  .composer-tools { gap: 2px; }
  .desktop { display: none; }
}
@media (pointer: coarse) { button { min-height: 44px; } }
@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
  .glass-panel, .message.user, .memory-record, .attachment, dialog { background: var(--bg-solid); }
}
@media (prefers-reduced-transparency: reduce) {
  body::before { display: none; }
  .ambient-background { display: none; }
  .welcome::before { display: none; }
  .glass-panel, .message.user, .memory-record, .attachment, dialog { background: var(--bg-solid); -webkit-backdrop-filter: none; backdrop-filter: none; }
  dialog::backdrop { -webkit-backdrop-filter: none; backdrop-filter: none; }
}
@media (forced-colors: active) {
  body::before { display: none; }
  .ambient-background { display: none; }
  .welcome::before { display: none; }
  .glass-panel, .message.user, .memory-record, .attachment, dialog { background: Canvas; border-color: CanvasText; box-shadow: none; -webkit-backdrop-filter: none; backdrop-filter: none; }
}
/* O fallback só desaparece após o primeiro desenho bem-sucedido. */
#neural-background { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
.ambient-background.neural-active .particle { display: none; }
